.tabs {
  display: flex;
  background: var(--card);
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 39, 51, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 27rpx;
  color: var(--text-muted);
  border-radius: 12rpx;
}

.tab.active {
  background: var(--brand);
  color: #fff;
  font-weight: 500;
}

.filter .semester-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 20rpx;
}

/* 奖励条目 */
.reward-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.reward-item:last-child {
  border-bottom: none;
}

.cert {
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f1f3f7;
}

.reward-item .main {
  flex: 1;
  min-width: 0;
}

.reward-item .title {
  font-size: 28rpx;
  font-weight: 500;
}

.reward-item .title .badge {
  margin-left: 12rpx;
}

.reward-item .desc {
  font-size: 23rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.reward-item .desc.redeemed {
  color: var(--success);
}

/* 奖券预览 */
.preview-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
  box-sizing: border-box;
}

.preview-image {
  width: 100%;
  border-radius: 16rpx;
}

.preview-tip {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  margin-top: 30rpx;
}
