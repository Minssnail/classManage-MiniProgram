<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'score' ? 'active' : ''}}" data-tab="score" bindtap="onSwitchTab">
      积分记录
    </view>
    <view class="tab {{tab === 'reward' ? 'active' : ''}}" data-tab="reward" bindtap="onSwitchTab">
      奖励记录
    </view>
  </view>

  <view class="card filter">
    <view class="semester-hint">{{className || '全部班级'}} · {{semesterLabel}}</view>
    <view class="field" wx:if="{{tab === 'score' || isTeacher}}">
      <input
        class="input"
        placeholder="输入学号筛选，留空看全部"
        value="{{studentId}}"
        bindinput="onStudentIdInput"
      />
    </view>
    <view class="field" wx:if="{{tab === 'score'}}">
      <picker
        class="picker"
        mode="selector"
        range="{{typeFilters}}"
        range-key="label"
        value="{{typeIndex}}"
        bindchange="onTypeChange"
      >
        <text>{{typeFilters[typeIndex].label}}</text>
        <text class="arrow">▾</text>
      </picker>
    </view>
    <view class="btn-row">
      <button class="btn btn-primary" bindtap="onSearch">查询</button>
      <button class="btn btn-plain" bindtap="onReset">重置</button>
    </view>
  </view>

  <!-- 积分记录 -->
  <block wx:if="{{tab === 'score'}}">
    <view class="card">
      <view class="card-title">
        积分记录
        <text class="sub">共 {{total}} 条</text>
      </view>
      <view wx:for="{{records}}" wx:key="_id" class="list-item">
        <view class="main">
          <view class="title">{{item.studentText}}</view>
          <view class="desc">{{item.typeLabel}}{{item.reason ? ' · ' + item.reason : ''}}</view>
          <view class="desc">{{item.timeText}} · 操作员 {{item.operator}}</view>
        </view>
        <view class="aside">
          <text class="badge {{item.countsTowardTotal === false ? 'badge-muted' : item.score > 0 ? 'badge-success' : 'badge-danger'}}">
            {{item.score > 0 ? '+' : ''}}{{item.score}}
          </text>
        </view>
      </view>
      <view wx:if="{{loaded && !records.length}}" class="empty">暂无积分记录</view>
    </view>
  </block>

  <!-- 奖励记录 -->
  <block wx:else>
    <view class="card">
      <view class="card-title">
        奖励记录
        <text class="sub">共 {{rewards.length}} 条</text>
      </view>
      <view wx:for="{{rewards}}" wx:key="_id" class="reward-item">
        <image
          class="cert"
          wx:if="{{item.certificateImage}}"
          src="{{item.certificateImage}}"
          mode="aspectFill"
          data-url="{{item.certificateImage}}"
          bindtap="onPreviewCertificate"
        />
        <view class="main">
          <view class="title">
            {{item.studentText}}
            <text
              class="badge {{item.isRedeemed ? 'badge-success' : 'badge-warning'}}"
            >{{item.isRedeemed ? '已兑换' : '未兑换'}}</text>
          </view>
          <view class="desc">{{item.rewardType}}{{item.reason ? ' · ' + item.reason : ''}}</view>
          <view class="desc">{{item.timeText}} · 操作员 {{item.operator}}</view>
          <view class="desc redeemed" wx:if="{{item.isRedeemed && item.redeemedText}}">
            兑换时间：{{item.redeemedText}}
          </view>
        </view>
      </view>
      <view wx:if="{{loaded && !rewards.length}}" class="empty">暂无奖励记录</view>
    </view>
  </block>

  <!-- 奖券预览浮层 -->
  <view class="preview-mask" wx:if="{{previewUrl}}" bindtap="onClosePreview">
    <image class="preview-image" src="{{previewUrl}}" mode="widthFix" />
    <view class="preview-tip">点击任意处关闭</view>
  </view>
</view>
