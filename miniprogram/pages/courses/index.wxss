.major-card {
  background: linear-gradient(135deg, #4c6ef5, #3b5bdb);
  color: #fff;
}

.major-name {
  font-size: 32rpx;
  font-weight: 600;
}

.major-meta {
  font-size: 23rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.major-stats {
  display: flex;
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.25);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
}

.stat-label {
  font-size: 21rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.tabs {
  display: flex;
  background: #f1f3f7;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
  border-radius: 10rpx;
}

.tab.active {
  background: #fff;
  color: var(--brand);
  font-weight: 500;
}

.course {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.course:last-child {
  border-bottom: none;
}

.course-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.course-name {
  font-size: 28rpx;
  font-weight: 500;
  flex: 1;
  padding-right: 16rpx;
}

.course-credits {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  flex-shrink: 0;
}

.course-code {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.tags {
  margin-top: 12rpx;
}

.tags .badge {
  margin-right: 10rpx;
}

.tip {
  margin-top: 12rpx;
  line-height: 1.6;
}

.goto {
  margin-top: 20rpx;
}
