/* 班级切换条 */
.class-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #4c6ef5, #3b5bdb);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.class-name {
  font-size: 30rpx;
  font-weight: 600;
}

.class-action {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.class-panel {
  margin-top: -4rpx;
}

.class-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.class-option:last-child {
  border-bottom: none;
}

.class-option .title {
  font-size: 28rpx;
  font-weight: 500;
}

.class-option.active .title {
  color: var(--brand);
}

.class-option .desc {
  font-size: 23rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.semester-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 39, 51, 0.05);
}

.semester-name {
  font-size: 28rpx;
  font-weight: 600;
}

.semester-arrow {
  font-size: 24rpx;
  color: var(--brand);
}

.semester-panel {
  margin-top: -8rpx;
}

.semester-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.semester-option:last-child {
  border-bottom: none;
}

.semester-option .title {
  font-size: 28rpx;
  font-weight: 500;
}

.semester-option .desc {
  font-size: 23rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.semester-option .badge {
  margin-left: 10rpx;
}

/* 概览卡片 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.stat-card {
  width: 48.5%;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.stat-card.brand {
  background: linear-gradient(135deg, #4c6ef5, #3b5bdb);
}

.stat-card.success {
  background: linear-gradient(135deg, #51cf66, #2f9e44);
}

.stat-card.warning {
  background: linear-gradient(135deg, #ffa94d, #f08c00);
}

.stat-card.info {
  background: linear-gradient(135deg, #3bc9db, #1098ad);
}

.stat-value {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

/* 条形图 */
.bar-row {
  margin-bottom: 24rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-head {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  margin-bottom: 10rpx;
}

.bar-label {
  color: var(--text);
}

.bar-value {
  color: var(--text-muted);
}

.bar-track {
  height: 16rpx;
  background: #f1f3f7;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4c6ef5, #3b5bdb);
  min-width: 8rpx;
}

/* 排行榜名次 */
.rank {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  margin-right: 20rpx;
  background: #f1f3f7;
  color: var(--text-muted);
  flex-shrink: 0;
}

.rank-1 {
  background: #ffd43b;
  color: #7a5a00;
}

.rank-2 {
  background: #dee2e6;
  color: #495057;
}

.rank-3 {
  background: #ffc9a0;
  color: #8a4b00;
}

/* 加分说明 */
.rule {
  border-bottom: 2rpx solid var(--border);
}

.rule:last-child {
  border-bottom: none;
}

.rule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 27rpx;
  font-weight: 500;
}

.rule-toggle {
  color: var(--brand);
  font-size: 32rpx;
  width: 40rpx;
  text-align: center;
}

.rule-body {
  font-size: 25rpx;
  color: var(--text-muted);
  line-height: 1.7;
  padding: 0 0 24rpx;
}

/* 晚修加分：单独统计，不计入总积分，弱化显示以免被当成总分的一部分 */
.night-score {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-muted);
  text-align: right;
}

.night-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.night-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.night-title {
  font-size: 27rpx;
  font-weight: 500;
}

.night-value {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--warning);
}

.night-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
