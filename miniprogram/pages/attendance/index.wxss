/* ---------- 教师端二维码 ---------- */
.qr-card {
  text-align: center;
}

.qr-stage {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  margin: 10rpx auto 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid var(--border);
  overflow: hidden;
}

.qr-canvas {
  width: 440rpx;
  height: 440rpx;
  display: block;
}

.qr-canvas.dim {
  opacity: 0.12;
}

.qr-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

.qr-mask.expired {
  color: var(--danger);
  font-weight: 500;
}

.countdown {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 24rpx;
}

.countdown-num {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--brand);
  padding: 0 6rpx;
}

.ttl-row {
  display: flex;
  align-items: center;
}

.ttl-picker {
  flex: 1;
  text-align: left;
  margin-right: 20rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.switch-row .muted {
  margin-right: 8rpx;
}

.hint {
  font-size: 23rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-top: 22rpx;
  text-align: left;
}

/* ---------- 学生端状态卡 ---------- */
.status-card {
  text-align: center;
  padding: 50rpx 28rpx;
}

.status-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin: 0 auto 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
}

.status-card.done .status-icon {
  background: var(--success-light);
  color: var(--success);
}

.status-card.pending .status-icon {
  background: var(--warning-light);
  color: var(--warning);
}

/* ---------- 场次（面授课 / 晚修） ---------- */
.tabs {
  display: flex;
  background: #f1f3f7;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
  border-radius: 10rpx;
}

.tab.active {
  background: #fff;
  color: var(--brand);
  font-weight: 500;
}

/* 班长的两个页签：出示考勤码 / 我的打卡 */
.mode-tabs {
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(31, 39, 51, 0.06);
}

/* 班长本人打卡 */
.self-checkin {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--border);
  text-align: center;
  font-size: 25rpx;
}

.self-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
}

.list-tip {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

/* 走读生的晚修一栏：不是缺勤，弱化显示 */
.session-state.exempt {
  color: var(--text-muted);
  opacity: 0.7;
}

.session-sum {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

/* 名单每行右侧并排两格：面授、晚修 */
.session-cells {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.session-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 108rpx;
}

.session-tag {
  font-size: 21rpx;
  color: var(--text-muted);
}

/* 学生端状态卡里的两场明细 */
.session-rows {
  margin-top: 18rpx;
}

.session-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 25rpx;
  padding: 12rpx 0;
  border-top: 2rpx solid var(--border);
}

.session-name {
  color: var(--text);
}

.session-state {
  color: var(--text-muted);
}

.status-text {
  font-size: 34rpx;
  font-weight: 600;
}

.status-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
}

.scan-btn {
  font-size: 32rpx;
  padding: 28rpx 0;
}

.step {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.8;
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-no {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.class-tip {
  background: var(--warning-light);
  color: #8a5300;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  text-align: left;
}

.class-tip .link {
  color: var(--brand);
  margin-left: 12rpx;
}

.status-class {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-light);
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}

.hint .link {
  color: var(--brand);
}
