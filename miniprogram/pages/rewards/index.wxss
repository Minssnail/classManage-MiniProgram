.student-chips {
  white-space: nowrap;
  margin-top: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: var(--text-muted);
  font-size: 24rpx;
}

.chip.active {
  background: var(--brand);
  color: #fff;
}

.tip {
  margin-top: 20rpx;
  line-height: 1.6;
}

.reward-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.reward-item:last-child {
  border-bottom: none;
}

.cert {
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f1f3f7;
}

.reward-item .main {
  flex: 1;
  min-width: 0;
}

.reward-item .title {
  font-size: 28rpx;
  font-weight: 500;
}

.reward-item .title .badge {
  margin-left: 12rpx;
}

.reward-item .desc {
  font-size: 23rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.reward-item .desc.redeemed {
  color: var(--success);
}

.redeem-btn {
  margin-top: 16rpx;
}

.preview-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
  box-sizing: border-box;
}

.preview-image {
  width: 100%;
  border-radius: 16rpx;
}

.preview-tip {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  margin-top: 30rpx;
}
