.student-chips {
  white-space: nowrap;
  margin-top: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: var(--text-muted);
  font-size: 24rpx;
}

.chip.active {
  background: var(--brand);
  color: #fff;
}

.tip {
  margin-top: 20rpx;
  line-height: 1.6;
}

/* ---------- 单人 / 批量切换 ---------- */
.tabs {
  display: flex;
  background: #f1f3f7;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
  border-radius: 10rpx;
}

.tab.active {
  background: #fff;
  color: var(--brand);
  font-weight: 500;
}

/* ---------- 批量选择 ---------- */
.pick-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pick-count {
  margin-left: 10rpx;
  color: var(--brand);
  font-weight: 500;
}

.pick-actions .link {
  margin-left: 24rpx;
  font-size: 25rpx;
  color: var(--brand);
}

.pick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.pick-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
  font-size: 25rpx;
  color: var(--text);
}

.pick-chip.on {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 500;
}
