.student-chips {
  white-space: nowrap;
  margin-top: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #f1f3f7;
  color: var(--text-muted);
  font-size: 24rpx;
}

.chip.active {
  background: var(--brand);
  color: #fff;
}

.tip {
  margin-top: 20rpx;
  line-height: 1.6;
}
