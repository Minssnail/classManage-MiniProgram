.login {
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #3b5bdb 0%, #4c6ef5 42%, #f2f4f8 42%, #f2f4f8 100%);
}

.hero {
  padding: 130rpx 0 80rpx;
  color: #fff;
}

.app-name {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}

.form {
  padding: 40rpx 36rpx 36rpx;
}

/* 授权同意勾选 */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #c7cedb;
  border-radius: 8rpx;
  margin-right: 14rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
}

.checkbox.checked {
  background: var(--brand);
  border-color: var(--brand);
}

.agree-text {
  flex: 1;
  font-size: 23rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

.agree-text .link {
  color: var(--brand);
}
