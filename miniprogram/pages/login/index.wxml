<view class="login">
  <view class="hero">
    <view class="app-name">班级管理系统</view>
    <view class="app-desc">考勤 · 积分 · 奖励 一站式管理</view>
  </view>

  <view class="card form">
    <view class="field">
      <view class="field-label">用户名</view>
      <input
        class="input"
        placeholder="学号 / 手机号 / 教师账号"
        value="{{username}}"
        data-field="username"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <input
        class="input"
        password
        placeholder="请输入密码"
        value="{{password}}"
        data-field="password"
        bindinput="onInput"
      />
    </view>

    <!-- 未取得同意前不收集任何信息，因此勾选是登录的前置条件 -->
    <view class="agree-row">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <view class="agree-text">
        <text bindtap="onToggleAgree">我已阅读并同意</text>
        <text class="link" data-type="terms" catchtap="onOpenDoc">《用户服务协议》</text>
        <text bindtap="onToggleAgree">和</text>
        <text class="link" data-type="privacy" catchtap="onOpenDoc">《隐私政策》</text>
      </view>
    </view>

    <button
      class="btn btn-primary"
      loading="{{submitting}}"
      disabled="{{!agreed}}"
      bindtap="onSubmit"
    >
      登 录
    </button>
  </view>
</view>
