.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 360rpx;
  padding: 10rpx 0 0;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.chart-value {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.chart-bar-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 40rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: linear-gradient(180deg, #4c6ef5, #3b5bdb);
  min-height: 6rpx;
}

.chart-label {
  font-size: 21rpx;
  color: var(--text-muted);
  margin-top: 14rpx;
}

.chart-foot {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border);
}

/* 类型占比条 */
.bar-row {
  margin-bottom: 24rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-head {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  margin-bottom: 10rpx;
}

.bar-track {
  height: 16rpx;
  background: #f1f3f7;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4c6ef5, #3b5bdb);
  min-width: 8rpx;
}
