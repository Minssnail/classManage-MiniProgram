.class-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-light);
  color: var(--brand);
  border-radius: 14rpx;
  padding: 18rpx 26rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
}

.class-bar .current {
  font-weight: 600;
}

.class-bar .link {
  font-size: 24rpx;
}

.tip {
  margin-top: 20rpx;
  line-height: 1.6;
}

.pending {
  color: var(--warning);
}

.row-actions {
  display: flex;
  margin-top: 14rpx;
}

.row-actions .btn {
  margin-right: 16rpx;
}

.privacy-note {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.7;
  margin-top: 12rpx;
}

.privacy-note .link {
  color: var(--brand);
}
