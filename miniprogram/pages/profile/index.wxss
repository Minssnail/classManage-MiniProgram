.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4c6ef5, #3b5bdb);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.role {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.score {
  text-align: right;
  flex-shrink: 0;
}

.score-value {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.score-label {
  font-size: 22rpx;
  opacity: 0.85;
}

/* 菜单 */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  font-size: 28rpx;
  border-bottom: 2rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.chevron {
  color: var(--text-muted);
  font-size: 34rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.logout {
  margin-top: 12rpx;
}

/* 浮层 */
.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
  box-sizing: border-box;
}

.modal {
  background: var(--card);
  border-radius: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  width: 100%;
}
